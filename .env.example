# Local PostgreSQL: docker compose up -d db
# Supabase: replace with the pooled/direct PostgreSQL URL from Project Settings.
DATABASE_URL=postgresql+psycopg://flight_app:change-me-local-only@localhost:5433/flight_ops
JWT_SECRET=replace-with-at-least-32-random-characters
APP_ENV=development
AUTO_CREATE_SCHEMA=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-this-password
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
IDEMPOTENCY_RETENTION_HOURS=48
PRICE_HOLD_MINUTES=45
WAITLIST_CLAIM_MINUTES=30
REFUND_ESCALATION_DAYS=3
OVERBOOKING_POLICY=hard_limit

# Optional request-triggered transactional email (Gmail SMTP app password).
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
GMAIL_FROM=

# Optional Stripe test/live checkout. Configure the signing secret in Stripe webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_BASE_URL=http://localhost:8000

# n8n workflow credentials are configured in the n8n credential store, not here.
# Pinecone is called from the n8n workflows; keep API keys out of workflow JSON.
